{
  "name": "dada",
  "version": "1.0.0",
  "private": true,
  "description": "An out-of-box UI solution for enterprise applications",
  "scripts": {
    "analyze": "cross-env ANALYZE=1 umi build",
    "build": "npm run build:prod",
    "build:dev": "cross-env REACT_APP_ENV=development umi build",
    "build:pre": "cross-env REACT_APP_ENV=pre umi build",
    "build:prod": "cross-env REACT_APP_ENV=production umi build",
    "start": "npm run start:dev",
    "start:dev": "cross-env REACT_APP_ENV=development MOCK=none UMI_ENV=dev umi dev",
    "start:pre": "cross-env REACT_APP_ENV=pre MOCK=none UMI_ENV=dev umi dev",
    "start:prod": "cross-env REACT_APP_ENV=production MOCK=none UMI_ENV=dev umi dev"
  },
  "lint-staged": {
    "**/*.less": "stylelint --syntax less",
    "**/*.{js,jsx,ts,tsx}": "npm run lint-staged:js",
    "**/*.{js,jsx,tsx,ts,less,md,json}": [
      "prettier --write"
    ]
  },
  "browserslist": [
    "> 1%",
    "last 2 versions",
    "not ie <= 10"
  ],
  "dependencies": {
    "@ant-design/icons": "^4.5.0",
    "@ant-design/pro-form": "^2.2.2",
    "@ant-design/pro-layout": "^6.15.3",
    "@ant-design/pro-table": "^2.30.8",
    "@designable/formily-antd": "^1.0.0-beta.45",
    "@dnd-kit/core": "^6.0.8",
    "@dnd-kit/sortable": "^7.0.2",
    "@formily/antd": "^2.2.20",
    "@formily/core": "^2.2.20",
    "@formily/react": "^2.2.20",
    "@umijs/route-utils": "^1.0.36",
    "ahooks": "^2.0.0",
    "ali-oss": "^6.17.1",
    "antd": "^4.20.0",
    "classnames": "^2.2.6",
    "copy-to-clipboard": "^3.3.3",
    "dayjs": "^1.11.11",
    "daypilot-pro-react": "https://npm.daypilot.org/daypilot-pro-react/trial/2024.3.5973.tar.gz",
    "echarts": "^5.6.0",
    "echarts-for-react": "^3.0.2",
    "fr-generator": "^2.8.4",
    "html2canvas": "^1.4.1",
    "immutability-helper": "^3.1.1",
    "lodash": "^4.17.11",
    "lodash-decorators": "^6.0.0",
    "moment": "^2.25.3",
    "numeral": "^2.0.6",
    "nzh": "^1.0.3",
    "omit.js": "^2.0.2",
    "qrcode.react": "^3.1.0",
    "qs": "^6.10.5",
    "react": "^17.0.0",
    "react-dev-inspector": "^1.1.1",
    "react-dom": "^17.0.0",
    "react-fittext": "^1.0.0",
    "react-helmet-async": "^1.0.4",
    "react-quill": "^2.0.0",
    "react-router": "^4.3.1",
